@model IEnumerable<CMS.Data.Entities.Post>
@{
    Layout = "_LayoutAdmin"; // Hoặc tên layout mới bạn vừa tạo ở bước trước nhé
}

<div class="container-fluid py-2">
    <!-- Tiêu đề & Nút thêm mới -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="text-slate-800 fw-bold mb-1 text-uppercase tracking-wide">Quản lý bài viết</h4>
            <p class="text-muted small m-0">Xem, biên tập, cập nhật các bài tin tức công nghệ và thủ thuật.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-circle-fill"></i> Thêm bài viết mới
        </a>
    </div>

    <!-- Thanh Lọc & Tìm kiếm nhanh -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-6 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchPost" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo tiêu đề bài viết...">
                    </div>
                </div>
                <div class="col-md-4 col-lg-3">
                    <select id="filterCategory" class="form-select">
                        <option value="">-- Tất cả danh mục --</option>
                        @foreach (var cat in Model.Select(m => m.Category?.Name).Distinct())
                        {
                            if (!string.IsNullOrEmpty(cat))
                            {
                                <option value="@cat">@cat</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-auto ms-md-auto">
                    <span class="badge bg-light text-dark border p-2">Tổng số: <strong class="text-primary">@Model.Count()</strong> bài viết</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách bài viết -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="postsTable">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th class="ps-4" style="width: 80px;">Hình ảnh</th>
                            <th>Tiêu đề</th>
                            <th style="width: 180px;">Danh mục</th>
                            <th style="width: 150px;">Ngày đăng</th>
                            <th class="text-end pe-4" style="width: 220px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-x display-4 d-block mb-2 text-black-50"></i>
                                    Chưa có bài viết nào trong hệ thống.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <!-- Ảnh thu nhỏ -->
                                    <td class="ps-4">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" class="rounded object-fit-cover shadow-sm border border-light" style="width: 60px; height: 45px;" alt="Thumbnail">
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted shadow-sm border" style="width: 60px; height: 45px;">
                                                <i class="bi bi-image small"></i>
                                            </div>
                                        }
                                    </td>
                                    <!-- Tiêu đề bài viết -->
                                    <td>
                                        <div class="fw-semibold text-dark text-truncate-2" style="max-width: 400px; font-size: 0.95rem;" title="@item.Title">
                                            @item.Title
                                        </div>
                                    </td>
                                    <!-- Danh mục (Badge) -->
                                    <td>
                                        <span class="badge bg-info bg-opacity-10 text-info px-2.5 py-1.5 border border-info border-opacity-25 fw-medium">
                                            <i class="bi bi-tag-fill me-1 small"></i> @(item.Category?.Name ?? "Chưa phân loại")
                                        </span>
                                    </td>
                                    <!-- Ngày đăng -->
                                    <td>
                                        <div class="small text-secondary fw-medium">
                                            <i class="bi bi-calendar3 me-1 opacity-70"></i> @item.CreatedDate.ToString("dd/MM/yyyy")
                                        </div>
                                    </td>
                                    <!-- Nhóm nút bấm hành động -->
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm shadow-sm" role="group">
                                            <a href="/Post/Details/@item.Id" class="btn btn-white border text-dark" title="Xem chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-white border text-warning" title="Sửa nội dung">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="btn btn-white border text-danger"
                                               title="Xóa bài"
                                               onclick="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?')">
                                                <i class="bi bi-trash3-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Script tìm kiếm và lọc danh mục nhanh ngay trên Front-end không cần load lại trang -->
    <script>
        $(document).ready(function () {
            // Bộ lọc tìm kiếm bằng chữ
            $("#searchPost").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                filterTable();
            });

            // Bộ lọc danh mục
            $("#filterCategory").on("change", function () {
                filterTable();
            });

            function filterTable() {
                var searchText = $("#searchPost").val().toLowerCase();
                var catText = $("#filterCategory").val();

                $("#postsTable tbody tr").each(function () {
                    var title = $(this).find("td:nth-child(2)").text().toLowerCase();
                    var category = $(this).find("td:nth-child(3)").text().trim();

                    var matchSearch = title.indexOf(searchText) > -1;
                    var matchCat = catText === "" || category.indexOf(catText) > -1;

                    if (matchSearch && matchCat) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }
        });
    </script>
}