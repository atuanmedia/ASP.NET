@model CMS.Data.Entities.Post

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Tạo bài viết mới";
}

<div class="container-fluid py-2">
    <!-- Breadcrumb điều hướng nhanh -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb bg-transparent p-0 m-0">
            <li class="breadcrumb-item"><a href="/Post" class="text-decoration-none text-muted">Quản lý bài viết</a></li>
            <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Thêm bài viết</li>
        </ol>
    </nav>

    <!-- Tiêu đề trang -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="text-slate-800 fw-bold mb-1 text-uppercase tracking-wide">Soạn thảo bài viết mới</h4>
            <p class="text-muted small m-0">Đăng tải tin tức công nghệ mới, hướng dẫn thủ thuật hoặc đánh giá thiết bị.</p>
        </div>
    </div>

    <!-- Form chính -->
    <form asp-action="Create" method="post" id="postForm">
        <!-- Validation Summary (ẩn mặc định, chỉ hiện khi có lỗi tổng quát) -->
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 mb-4" role="alert"></div>

        <div class="row g-4">
            <!-- Cột trái: Tiêu đề và vùng viết nội dung bài -->
            <div class="col-xl-9 col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <!-- Trường nhập Tiêu đề -->
                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold text-slate-700">Tiêu đề bài viết <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control form-control-lg fs-5 border" placeholder="Ví dụ: Đánh giá iPhone 15 Pro Max sau 6 tháng sử dụng..." />
                            <span asp-validation-for="Title" class="text-danger small mt-1 d-block fw-medium"></span>
                        </div>

                        <!-- Trường nhập Nội dung Rich Text -->
                        <div class="mb-2">
                            <label asp-for="Content" class="form-label fw-bold text-slate-700">Nội dung chi tiết <span class="text-danger">*</span></label>
                            <!-- Tùy biến vùng soạn thảo thông qua CSS -->
                            <div class="editor-wrapper">
                                <textarea asp-for="Content" class="form-control" rows="12"></textarea>
                            </div>
                            <span asp-validation-for="Content" class="text-danger small mt-1 d-block fw-medium"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Cấu hình bổ sung, Ảnh thumbnail & Nút hành động -->
            <div class="col-xl-3 col-lg-4">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-transparent border-bottom py-3">
                        <h6 class="m-0 fw-bold text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-gear-fill text-primary"></i> Cấu hình bài đăng
                        </h6>
                    </div>
                    <div class="card-body p-3 text-slate-700">
                        <!-- Chọn Chuyên mục bài viết -->
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label small fw-bold">Chuyên mục <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryList">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block fw-medium"></span>
                        </div>

                        <!-- Nhập URL Ảnh đại diện kèm tính năng Xem trước tự động -->
                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label small fw-bold">Link ảnh đại diện (URL)</label>
                            <input asp-for="ImageUrl" id="imageUrlInput" class="form-control form-control-sm mb-2" placeholder="https://abc.com/image.jpg" />
                            <span asp-validation-for="ImageUrl" class="text-danger small mt-1 d-block fw-medium"></span>

                            <!-- Khung live preview ảnh -->
                            <div id="imagePreviewContainer" class="bg-light rounded text-center border d-flex align-items-center justify-content-center overflow-hidden" style="height: 150px;">
                                <div id="previewPlaceholder" class="text-muted p-2">
                                    <i class="bi bi-image display-6 d-block mb-1 opacity-50"></i>
                                    <small class="d-block text-xs">Dán URL ảnh để xem trước</small>
                                </div>
                                <img id="imagePreview" src="" class="w-100 h-100 object-fit-cover d-none" alt="Live Preview">
                            </div>
                        </div>

                        <!-- Ngày đăng bài (Mặc định ngày giờ hiện tại hệ thống) -->
                        <div class="mb-3">
                            <label asp-for="CreatedDate" class="form-label small fw-bold">Ngày giờ xuất bản</label>
                            <input asp-for="CreatedDate" type="datetime-local" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="CreatedDate" class="text-danger small mt-1 d-block fw-medium"></span>
                        </div>

                        <hr class="my-3 text-black-50" />

                        <!-- Các nút tương tác hành động -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary fw-semibold shadow-sm py-2">
                                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Lưu & Xuất bản
                            </button>
                            <a asp-action="Index" class="btn btn-white border text-dark fw-medium py-2">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Styles {
    <style>
        .text-slate-800 {
            color: #1e293b;
        }

        .text-slate-700 {
            color: #334155;
        }

        .text-xs {
            font-size: 0.75rem;
        }

        /* Định hình lại chiều cao tối thiểu cho khung nhập CKEditor 5 */
        .editor-wrapper .ck-editor__editable_inline {
            min-height: 350px !important;
            color: #212529;
        }
        /* Đồng bộ đường viền CKEditor với phong cách Bootstrap mượt mà */
        .editor-wrapper .ck.ck-editor__top .ck-toolbar {
            border-top-left-radius: 0.375rem !important;
            border-top-right-radius: 0.375rem !important;
            border-color: #dee2e6 !important;
            background-color: #f8f9fa !important;
        }

        .editor-wrapper .ck.ck-editor__main > .ck-editor__editable {
            border-bottom-left-radius: 0.375rem !important;
            border-bottom-right-radius: 0.375rem !important;
            border-color: #dee2e6 !important;
        }
    </style>
}

@section Scripts {
    <!-- Nhúng thư viện CKEditor 5 -->
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>

    <!-- Nhúng Script Validation của Microsoft gốc để kiểm tra lỗi Client-Side ngay lập tức mà không cần tải lại trang -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            // 1. Kích hoạt Trình soạn thảo và tinh giản thanh công cụ cho Admin
            ClassicEditor
                .create(document.querySelector('#Content'), {
                    toolbar: [ 'heading', '|', 'bold', 'italic', 'link', 'bulletedList', 'numberedList', 'blockQuote', 'insertTable', 'undo', 'redo' ]
                })
                .catch(error => {
                    console.error(error);
                });

            // 2. Tính năng xử lý tự động Live Preview ảnh từ URL đầu vào
            function previewImageUrl() {
                var url = $('#imageUrlInput').val().trim();
                var $img = $('#imagePreview');
                var $placeholder = $('#previewPlaceholder');

                if (url !== "") {
                    $img.attr('src', url).removeClass('d-none');
                    $placeholder.addClass('d-none');
                } else {
                    $img.addClass('d-none').attr('src', '');
                    $placeholder.removeClass('d-none');
                }
            }

            // Lắng nghe sự kiện đổi chữ hoặc dán link vào ô nhập ảnh
            $('#imageUrlInput').on('input change blur', function () {
                previewImageUrl();
            });

            // Chạy kiểm tra ngay lúc đầu phòng trường hợp có sẵn dữ liệu khi sửa đổi/giao diện lỗi
            previewImageUrl();
        });
    </script>
}