@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<div class="container-fluid py-2">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb bg-transparent p-0 m-0">
            <li class="breadcrumb-item">
                <a asp-action="Index" class="text-decoration-none text-muted">
                    Quản lý sản phẩm
                </a>
            </li>
            <li class="breadcrumb-item active text-dark fw-medium">
                Thêm sản phẩm
            </li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-slate-800 text-uppercase mb-1">
                Thêm sản phẩm mới
            </h4>
            <p class="text-muted mb-0">
                Nhập thông tin sản phẩm, giá bán và hình ảnh hiển thị.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-light border">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <!-- FORM -->
    <form asp-action="Create" method="post" enctype="multipart/form-data">

        <div class="row g-4">

            <!-- LEFT -->
            <div class="col-xl-9 col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">

                        <!-- Tên sản phẩm -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-slate-700">
                                Tên sản phẩm <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Name"
                                   class="form-control form-control-lg"
                                   placeholder="Ví dụ: Laptop Gaming MSI..." />

                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Mô tả -->
                        <div>
                            <label class="form-label fw-bold text-slate-700">
                                Mô tả sản phẩm
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="10"
                                      placeholder="Nhập mô tả chi tiết sản phẩm..."></textarea>

                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="col-xl-3 col-lg-4">

                <!-- CONFIG CARD -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-transparent border-bottom py-3">
                        <h6 class="m-0 fw-bold text-dark">
                            Cấu hình sản phẩm
                        </h6>
                    </div>

                    <div class="card-body p-3">

                        <!-- Giá -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Giá bán</label>
                            <input asp-for="Price" type="number" class="form-control form-control-sm" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <!-- Tồn kho -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Tồn kho</label>
                            <input asp-for="StockQuantity" type="number" class="form-control form-control-sm" />
                            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                        </div>

                        <!-- Danh mục -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Danh mục</label>
                            <select asp-for="CategoryProductId"
                                    asp-items="ViewBag.CategoryList"
                                    class="form-select form-select-sm">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryProductId" class="text-danger small"></span>
                        </div>

                        <hr />

                        <!-- IMAGE URL + PREVIEW -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Hình ảnh</label>

                            <input asp-for="ImageUrl"
                                   id="imageUrlInput"
                                   class="form-control form-control-sm mb-2"
                                   placeholder="https://..." />

                            <div class="border rounded d-flex align-items-center justify-content-center overflow-hidden bg-light"
                                 style="height:150px;">
                                <img id="imagePreview"
                                     class="w-100 h-100 object-fit-cover d-none" />
                                <div id="imagePlaceholder" class="text-muted small">
                                    Chưa có ảnh
                                </div>
                            </div>
                        </div>

                        <!-- BUTTONS -->
                        <div class="d-grid gap-2 mt-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i> Lưu sản phẩm
                            </button>

                            <a asp-action="Index" class="btn btn-light border">
                                Quay lại
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </form>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <script>
        function previewImage() {
            var url = $('#imageUrlInput').val();

            if (url && url.trim() !== "") {
                $('#imagePreview').attr('src', url).removeClass('d-none');
                $('#imagePlaceholder').hide();
            } else {
                $('#imagePreview').addClass('d-none');
                $('#imagePlaceholder').show();
            }
        }

        $('#imageUrlInput').on('input change', function () {
            previewImage();
        });

        previewImage();
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}