@model IEnumerable<CMS.Data.Entities.Order>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Danh sách đơn hàng";
}

<div class="container-fluid py-2">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb bg-transparent p-0 m-0">
            <li class="breadcrumb-item">
                <a href="#" class="text-decoration-none text-muted">Quản trị</a>
            </li>
            <li class="breadcrumb-item active text-dark fw-medium">
                Đơn hàng
            </li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-slate-800 text-uppercase mb-1">
                Danh sách đơn hàng
            </h4>
            <p class="text-muted mb-0">
                Quản lý toàn bộ đơn hàng trong hệ thống
            </p>
        </div>
    </div>

    <!-- TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>#ID</th>
                            <th>Ngày đặt</th>
                            <th>Khách hàng</th>
                            <th>Trạng thái</th>
                            <th>Ghi chú</th>
                            <th class="text-end">Chi tiết</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- ID -->
                                <td class="fw-semibold">
                                    #@item.Id
                                </td>

                                <!-- DATE -->
                                <td class="text-muted small">
                                    @item.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <!-- CUSTOMER -->
                                <td class="fw-medium">
                                    @item.Customer?.FullName
                                </td>

                                <!-- STATUS -->
                                <td>
                                    @switch (item.Status)
                                    {
                                        case 0:
                                            <span class="badge bg-warning text-dark">Chờ duyệt</span>
                                            break;

                                        case 1:
                                            <span class="badge bg-info text-dark">Đang giao</span>
                                            break;

                                        case 2:
                                            <span class="badge bg-success">Hoàn tất</span>
                                            break;

                                        default:
                                            <span class="badge bg-secondary">Không xác định</span>
                                            break;
                                    }
                                </td>

                                <!-- NOTES -->
                                <td class="text-muted small">
                                    @(string.IsNullOrEmpty(item.Notes) ? "Không có ghi chú" : item.Notes)
                                </td>

                                <!-- ACTION -->
                                <td class="text-end">

                                    <a href="/Order/Details/@item.Id"
                                       class="btn btn-sm btn-primary">
                                        <i class="bi bi-eye"></i> Xem
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>