@model CMS.Data.Entities.Advertisement
@{
    ViewData["Title"] = "Thêm Banner";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-plus-square text-primary me-2"></i>Thêm banner mới</h4>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card card-custom p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">Tiêu đề <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" placeholder="VD: Nội Thất Thông Minh 2024" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Mô tả ngắn (subtitle)</label>
                    <input asp-for="Subtitle" class="form-control" placeholder="VD: Không gian sống hiện đại cho ngôi nhà tương lai" />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Tên nút bấm</label>
                        <input asp-for="ButtonText" class="form-control" placeholder="VD: Khám phá ngay" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Đường dẫn nút bấm</label>
                        <input asp-for="ButtonLink" class="form-control" placeholder="VD: /shop" />
                    </div>
                </div>

                <!-- Upload ảnh -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Ảnh banner <span class="text-danger">*</span></label>
                    <div class="border rounded-3 p-3 bg-light">
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Upload từ máy tính</label>
                            <input type="file" name="uploadImage" class="form-control form-control-sm" accept="image/*"
                                   onchange="previewImage(this)" />
                        </div>
                        <div class="text-center text-muted small my-2">— hoặc —</div>
                        <div>
                            <label class="form-label small text-muted mb-1">Nhập URL ảnh</label>
                            <input asp-for="ImageUrl" class="form-control form-control-sm"
                                   placeholder="https://..." oninput="previewUrl(this.value)" />
                        </div>
                        <!-- Preview -->
                        <div id="imgPreview" class="mt-3 d-none">
                            <img id="previewImg" src="" alt="Preview"
                                 class="rounded-3 w-100" style="max-height:200px;object-fit:cover" />
                        </div>
                    </div>
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Thứ tự hiển thị</label>
                        <input asp-for="SortOrder" type="number" min="1" class="form-control" />
                    </div>
                    <div class="col-md-8 d-flex align-items-end">
                        <div class="form-check form-switch mb-1">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Hiển thị ngay</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-floppy-fill me-1"></i> Lưu banner
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tips -->
    <div class="col-lg-4">
        <div class="card card-custom p-3 bg-light border-0">
            <h6 class="fw-bold mb-2"><i class="bi bi-lightbulb-fill text-warning me-1"></i>Gợi ý</h6>
            <ul class="small text-muted mb-0 ps-3">
                <li class="mb-1">Kích thước ảnh lý tưởng: <strong>1600 × 700px</strong></li>
                <li class="mb-1">Dùng ảnh ngang, tỉ lệ 16:7</li>
                <li class="mb-1">Dung lượng tối đa: 5MB</li>
                <li class="mb-1">Thứ tự nhỏ hơn → hiển thị trước</li>
                <li>Tắt "Hiển thị" để ẩn slide tạm thời</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
<script>
function previewImage(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => showPreview(e.target.result);
        reader.readAsDataURL(input.files[0]);
    }
}
function previewUrl(url) {
    if (url.startsWith('http')) showPreview(url);
}
function showPreview(src) {
    document.getElementById('previewImg').src = src;
    document.getElementById('imgPreview').classList.remove('d-none');
}
</script>
}
