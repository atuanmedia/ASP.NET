@model IEnumerable<CMS.Data.Entities.Advertisement>
@{
    ViewData["Title"] = "Quản lý Banner / Slide";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-images text-primary me-2"></i>Banner & Slide quảng cáo</h4>
        <small class="text-muted">Quản lý hình ảnh hiển thị trên trang chủ</small>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm px-3">
        <i class="bi bi-plus-lg me-1"></i> Thêm banner
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-images" style="font-size:3rem;opacity:.3"></i>
        <p class="mt-3">Chưa có banner nào. <a asp-action="Create">Thêm ngay</a></p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card card-custom h-100 overflow-hidden">
                    <!-- Ảnh banner -->
                    <div style="height:180px;overflow:hidden;position:relative;background:#f1f5f9">
                        <img src="@item.ImageUrl" alt="@item.Title"
                             style="width:100%;height:100%;object-fit:cover;"
                             onerror="this.src='https://placehold.co/600x200?text=No+Image'" />
                        <!-- Badge thứ tự -->
                        <span class="badge bg-dark position-absolute" style="top:8px;left:8px;font-size:.75rem">
                            #@item.SortOrder
                        </span>
                        <!-- Badge trạng thái -->
                        <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary") position-absolute" style="top:8px;right:8px">
                            @(item.IsActive ? "Đang hiển thị" : "Ẩn")
                        </span>
                    </div>

                    <div class="card-body pb-2">
                        <h6 class="fw-bold mb-1 text-truncate">@item.Title</h6>
                        <p class="text-muted small mb-1 text-truncate">@(item.Subtitle ?? "—")</p>
                        @if (!string.IsNullOrEmpty(item.ButtonText))
                        {
                            <span class="badge bg-light text-dark border me-1">
                                <i class="bi bi-cursor-fill me-1"></i>@item.ButtonText
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(item.ButtonLink))
                        {
                            <span class="badge bg-light text-primary border small">@item.ButtonLink</span>
                        }
                    </div>

                    <div class="card-footer bg-transparent border-top-0 d-flex gap-2 pb-3 px-3">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary flex-fill">
                            <i class="bi bi-pencil-fill me-1"></i>Sửa
                        </a>

                        <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="flex-fill">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-secondary" : "btn-outline-success") w-100">
                                <i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-eye") me-1"></i>
                                @(item.IsActive ? "Ẩn" : "Hiện")
                            </button>
                        </form>

                        <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                              onsubmit="return confirm('Xóa banner này?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger px-3">
                                <i class="bi bi-trash3-fill"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
