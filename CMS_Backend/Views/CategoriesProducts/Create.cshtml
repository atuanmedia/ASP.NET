@model CMS.Data.Entities.CategoryProduct
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm danh mục sản phẩm";
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
    <h4 class="fw-bold mb-0"><i class="bi bi-plus-square text-primary me-2"></i>Thêm danh mục sản phẩm</h4>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card card-custom p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">Tên danh mục <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="VD: Sofa, Bàn, Giường..." required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Mô tả ngắn</label>
                    <textarea asp-for="Description" class="form-control" rows="2"
                              placeholder="Mô tả ngắn về danh mục..."></textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Ảnh đại diện danh mục</label>
                    <div class="border rounded-3 p-3 bg-light">
                        <label class="form-label small text-muted mb-1">Upload từ máy tính</label>
                        <input type="file" name="uploadImage" class="form-control form-control-sm"
                               accept="image/*" onchange="previewImage(this)" />
                        <div class="text-center text-muted small my-2">— hoặc —</div>
                        <label class="form-label small text-muted mb-1">Nhập URL ảnh</label>
                        <input asp-for="ImageUrl" class="form-control form-control-sm"
                               placeholder="https://..." oninput="previewUrl(this.value)" />
                        <div id="imgPreview" class="mt-3 d-none">
                            <img id="previewImg" src="" alt="Preview"
                                 class="rounded-3 w-100" style="max-height:180px;object-fit:cover" />
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-floppy-fill me-1"></i> Lưu danh mục
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card card-custom p-3 bg-light border-0">
            <h6 class="fw-bold mb-2"><i class="bi bi-lightbulb-fill text-warning me-1"></i>Gợi ý ảnh đẹp</h6>
            <ul class="small text-muted mb-0 ps-3">
                <li class="mb-1">Kích thước lý tưởng: <strong>600 × 400px</strong></li>
                <li class="mb-1">Tỉ lệ 3:2 hoặc 4:3</li>
                <li class="mb-1">Ảnh chụp sản phẩm thực tế, nền sạch</li>
                <li>Dùng ảnh chất lượng cao để trông chuyên nghiệp</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
<script>
function previewImage(input) {
    if (input.files?.[0]) {
        const reader = new FileReader();
        reader.onload = e => showPreview(e.target.result);
        reader.readAsDataURL(input.files[0]);
    }
}
function previewUrl(url) { if (url.startsWith('http')) showPreview(url); }
function showPreview(src) {
    document.getElementById('previewImg').src = src;
    document.getElementById('imgPreview').classList.remove('d-none');
}
</script>
}
