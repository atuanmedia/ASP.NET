@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="container-fluid py-3">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-slate-800 text-uppercase mb-1">
                Thêm sản phẩm mới
            </h4>

            <p class="text-muted mb-0">
                Nhập thông tin thiết bị, giá bán và cấu hình kho hàng.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <!-- Form -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                <div class="row g-4">

                    <!-- Tên sản phẩm -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Tên sản phẩm
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Ví dụ: Laptop Gaming MSI..." />

                        <span asp-validation-for="Name"
                              class="text-danger small"></span>
                    </div>

                    <!-- Giá -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            Giá bán
                        </label>

                        <input asp-for="Price"
                               type="number"
                               class="form-control"
                               placeholder="0" />

                        <span asp-validation-for="Price"
                              class="text-danger small"></span>
                    </div>

                    <!-- Tồn kho -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            Tồn kho
                        </label>

                        <input asp-for="StockQuantity"
                               type="number"
                               class="form-control"
                               placeholder="0" />

                        <span asp-validation-for="StockQuantity"
                              class="text-danger small"></span>
                    </div>

                    <!-- Danh mục -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Danh mục sản phẩm
                        </label>

                        <select asp-for="CategoryProductId"
                                asp-items="ViewBag.CategoryList"
                                class="form-select">

                            <option value="">
                                -- Chọn danh mục --
                            </option>

                        </select>

                        <span asp-validation-for="CategoryProductId"
                              class="text-danger small"></span>
                    </div>

                    <!-- Upload ảnh -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Hình ảnh sản phẩm
                        </label>

                        <input type="file"
                               name="uploadImage"
                               class="form-control" />
                    </div>

                    <!-- Mô tả -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            Mô tả sản phẩm
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Nhập mô tả cấu hình, thông số kỹ thuật..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small"></span>
                    </div>

                </div>

                <!-- Buttons -->
                <div class="mt-4 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary px-4">

                        <i class="bi bi-save2-fill me-1"></i>
                        Lưu sản phẩm

                    </button>

                    <a asp-action="Index"
                       class="btn btn-light border px-4">

                        Hủy

                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Styles {
    <style>
        .text-slate-800 {
            color: #1e293b;
        }

        .form-control,
        .form-select {
            padding: 10px 14px;
            border-radius: 10px;
        }

        .card {
            border-radius: 18px;
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}