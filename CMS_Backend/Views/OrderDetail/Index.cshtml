@* @model IEnumerable<CMS.Data.Entities.OrderDetail>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="container-fluid py-2">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb bg-transparent p-0 m-0">
            <li class="breadcrumb-item">
                <a href="/Order" class="text-decoration-none text-muted">
                    Đơn hàng
                </a>
            </li>
            <li class="breadcrumb-item active text-dark fw-medium">
                Chi tiết đơn hàng
            </li>
        </ol>
    </nav>

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-slate-800 text-uppercase mb-1">
                Chi tiết đơn hàng
            </h4>
            <p class="text-muted mb-0">
                Danh sách sản phẩm trong đơn hàng
            </p>
        </div>
    </div>

    <!-- TABLE CARD -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- PRODUCT INFO -->
                                <td>
                                    <div class="d-flex align-items-center gap-3">

                                        <!-- IMAGE -->
                                        <img src="@(item.Product?.ImageUrl ?? "https://via.placeholder.com/80")"
                                             class="rounded border"
                                             style="width:60px;height:60px;object-fit:cover;" />

                                        <div>
                                            <div class="fw-semibold text-dark">
                                                @item.Product?.Name
                                            </div>

                                            <div class="text-muted small">
                                                ID: #@item.ProductId
                                            </div>
                                        </div>

                                    </div>
                                </td>

                                <!-- QUANTITY -->
                                <td class="text-center">
                                    <span class="badge bg-primary">
                                        @item.Quantity
                                    </span>
                                </td>

                                <!-- UNIT PRICE -->
                                <td class="text-end text-muted">
                                    @item.UnitPrice.ToString("N0") đ
                                </td>

                                <!-- TOTAL -->
                                <td class="text-end fw-bold text-success">
                                    @{
                                        var total = item.Quantity * item.UnitPrice;
                                    }
                                    @total.ToString("N0") đ
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div> *@