@model CMS.Data.Entities.Post

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Cập nhật bài viết";
}

<div class="container-fluid py-2">
    <!-- Breadcrumb điều hướng nhanh -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb bg-transparent p-0 m-0">
            <li class="breadcrumb-item"><a href="/Post" class="text-decoration-none text-muted">Quản lý bài viết</a></li>
            <li class="breadcrumb-item"><a href="/Post/Details/@Model.Id" class="text-decoration-none text-muted">Chi tiết</a></li>
            <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Chỉnh sửa</li>
        </ol>
    </nav>

    <!-- Tiêu đề trang -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="text-slate-800 fw-bold mb-1 text-uppercase tracking-wide">Hiệu chỉnh bài viết</h4>
            <p class="text-muted small m-0">Thay đổi nội dung, cập nhật hình ảnh minh họa hoặc điều chỉnh lại chuyên mục.</p>
        </div>
    </div>

    <!-- Một Form duy nhất, loại bỏ lỗi lồng form -->
    <form asp-action="Edit" method="post" id="editPostForm">
        <!-- Khóa chính ẩn để lưu đúng bài viết -->
        <input type="hidden" asp-for="Id" />

        <!-- Hiển thị thông báo lỗi nếu dữ liệu không hợp lệ từ Server -->
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 mb-4" role="alert"></div>

        <div class="row g-4">
            <!-- Cột trái: Tiêu đề và vùng nội dung chính bài viết -->
            <div class="col-xl-9 col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <!-- Tiêu đề -->
                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold text-slate-700">Tiêu đề bài viết <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control form-control-lg fs-5 border" placeholder="Nhập tiêu đề bài viết..." />
                            <span asp-validation-for="Title" class="text-danger small mt-1 d-block fw-medium"></span>
                        </div>

                        <!-- Nội dung Rich Text -->
                        <div class="mb-2">
                            <label asp-for="Content" class="form-label fw-bold text-slate-700">Nội dung chi tiết <span class="text-danger">*</span></label>
                            <div class="editor-wrapper">
                                <textarea asp-for="Content" class="form-control" rows="12"></textarea>
                            </div>
                            <span asp-validation-for="Content" class="text-danger small mt-1 d-block fw-medium"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Metadata, Ảnh đại diện đang có & Nút lưu -->
            <div class="col-xl-3 col-lg-4">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-transparent border-bottom py-3">
                        <h6 class="m-0 fw-bold text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-sliders text-primary"></i> Cập nhật thông số
                        </h6>
                    </div>
                    <div class="card-body p-3 text-slate-700">
                        <!-- Chọn Chuyên mục -->
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label small fw-bold">Chuyên mục <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryList">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block fw-medium"></span>
                        </div>

                        <!-- URL Ảnh đại diện & Live Preview ảnh hiện tại -->
                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label small fw-bold">Link ảnh đại diện (URL)</label>
                            <input asp-for="ImageUrl" id="imageUrlInput" class="form-control form-control-sm mb-2" placeholder="https://abc.com/image.jpg" />
                            <span asp-validation-for="ImageUrl" class="text-danger small mt-1 d-block fw-medium"></span>

                            <!-- Khung hiển thị trước hình ảnh đã có hoặc hình ảnh mới thay đổi -->
                            <div id="imagePreviewContainer" class="bg-light rounded text-center border d-flex align-items-center justify-content-center overflow-hidden" style="height: 150px;">
                                <div id="previewPlaceholder" class="text-muted p-2 d-none">
                                    <i class="bi bi-image display-6 d-block mb-1 opacity-50"></i>
                                    <small class="d-block text-xs">Chưa có ảnh đại diện</small>
                                </div>
                                <img id="imagePreview" src="@Model.ImageUrl" class="w-100 h-100 object-fit-cover" alt="Current Preview">
                            </div>
                        </div>

                        <!-- Giữ lại hoặc sửa đổi ngày giờ đăng gốc -->
                        <div class="mb-3">
                            <label asp-for="CreatedDate" class="form-label small fw-bold">Ngày giờ đăng bài</label>
                            <!-- Chuyển sang datetime-local để bảo toàn cả giờ và phút đăng bài -->
                            <input asp-for="CreatedDate" type="datetime-local" class="form-control form-control-sm" value="@Model.CreatedDate.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="CreatedDate" class="text-danger small mt-1 d-block fw-medium"></span>
                        </div>

                        <hr class="my-3 text-black-50" />

                        <!-- Các nút tương tác -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success fw-semibold shadow-sm py-2">
                                <i class="bi bi-check-lg me-1"></i> Lưu thay đổi
                            </button>
                            <a href="/Post/Details/@Model.Id" class="btn btn-white border text-dark fw-medium py-2">
                                Hủy thay đổi
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Styles {
    <style>
        .text-slate-800 {
            color: #1e293b;
        }

        .text-slate-700 {
            color: #334155;
        }

        .text-xs {
            font-size: 0.75rem;
        }

        /* Cấu hình đồng bộ độ cao CKEditor 5 */
        .editor-wrapper .ck-editor__editable_inline {
            min-height: 350px !important;
            color: #212529;
        }

        .editor-wrapper .ck.ck-editor__top .ck-toolbar {
            border-top-left-radius: 0.375rem !important;
            border-top-right-radius: 0.375rem !important;
            border-color: #dee2e6 !important;
            background-color: #f8f9fa !important;
        }

        .editor-wrapper .ck.ck-editor__main > .ck-editor__editable {
            border-bottom-left-radius: 0.375rem !important;
            border-bottom-right-radius: 0.375rem !important;
            border-color: #dee2e6 !important;
        }
    </style>
}

@section Scripts {
    <!-- CKEditor 5 core -->
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>

    <!-- Script kiểm tra ràng buộc phía Client không cần reload trang -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            // 1. Khởi động trình soạn thảo văn bản
            ClassicEditor
                .create(document.querySelector('#Content'), {
                    toolbar: [ 'heading', '|', 'bold', 'italic', 'link', 'bulletedList', 'numberedList', 'blockQuote', 'insertTable', 'undo', 'redo' ]
                })
                .catch(error => {
                    console.error(error);
                });

            // 2. Logic kiểm tra và cập nhật thay đổi ảnh liên tục (Live Preview)
            function checkLivePreviewImage() {
                var url = $('#imageUrlInput').val().trim();
                var $img = $('#imagePreview');
                var $placeholder = $('#previewPlaceholder');

                if (url !== "") {
                    $img.attr('src', url).removeClass('d-none');
                    $placeholder.addClass('d-none');
                } else {
                    $img.addClass('d-none').attr('src', '');
                    $placeholder.removeClass('d-none');
                }
            }

            // Theo dõi hành động dán link hoặc thay đổi text của admin
            $('#imageUrlInput').on('input change blur', function () {
                checkLivePreviewImage();
            });

            // Gọi chạy ngay lập tức khi tải trang để render ra ảnh cũ đang lưu trong Database
            checkLivePreviewImage();
        });
    </script>
}