@model CMS.Data.Entities.Post
@{
    Layout = "_LayoutAdmin";
}

<div class="container-fluid py-2">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb bg-transparent p-0 m-0">
            <li class="breadcrumb-item"><a href="/Post" class="text-decoration-none text-muted">Quản lý bài viết</a></li>
            <li class="breadcrumb-item active text-dark fw-medium" aria-current="page">Chi tiết bài viết</li>
        </ol>
    </nav>

    <!-- Header & Action -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="text-slate-800 fw-bold mb-1 text-uppercase tracking-wide">Xem trước bài viết</h4>
            <p class="text-muted small m-0">Kiểm tra nội dung, hình ảnh và bố cục hiển thị trước khi xuất bản.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Post" class="btn btn-white border text-dark shadow-sm fw-medium">
                <i class="bi bi-arrow-left me-1"></i> Danh sách
            </a>
            <a href="/Post/Edit/@Model.Id" class="btn btn-warning shadow-sm fw-medium text-white px-4">
                <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa bài viết
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Cột trái: Nội dung chính bài viết -->
        <div class="col-xl-9 col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4 p-md-5">
                    <!-- Tiêu đề -->
                    <h1 class="fs-2 fw-bold text-slate-900 mb-3 leading-snug">@Model.Title</h1>

                    <!-- Nội dung bài viết đã sửa lỗi cú pháp <<div -->
                    <div class="post-content text-slate-700 lh-relaxed fs-6 mt-4 pt-3 border-top">
                        @if (Model.Content != null)
                        {
                            @Html.Raw(Model.Content)
                        }
                        else
                        {
                            <p class="text-muted italic">Bài viết này chưa có nội dung chi tiết.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Thông tin cấu hình / Metadata cho Admin -->
        <div class="col-xl-3 col-lg-4">
            <!-- Hộp thông tin xuất bản -->
            <div class="card border-0 shadow-sm mb-4 text-slate-700">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="m-0 fw-bold text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill text-primary"></i> Thông tin bài đăng
                    </h6>
                </div>
                <div class="card-body p-3">
                    <!-- Ảnh đại diện bài viết -->
                    <div class="mb-3 text-center bg-light rounded overflow-hidden border border-light position-relative" style="height: 160px;">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" class="w-100 h-100 object-fit-cover" alt="Thumbnail">
                        }
                        else
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                                <i class="bi bi-image display-6 mb-1"></i>
                                <small>Chưa có ảnh đại diện</small>
                            </div>
                        }
                    </div>

                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent py-2.5">
                            <span class="text-muted">Chuyên mục:</span>
                            @if (Model.Category != null)
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 fw-semibold">
                                    @Model.Category.Name
                                </span>
                            }
                            else
                            {
                                <span class="text-danger fw-medium">Chưa phân loại</span>
                            }
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent py-2.5">
                            <span class="text-muted">Mã bài viết:</span>
                            <span class="fw-bold text-dark">#POST-@Model.Id.ToString("D4")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent py-2.5">
                            <span class="text-muted">Ngày tạo:</span>
                            <span class="fw-medium text-dark">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent py-2.5">
                            <span class="text-muted">Trạng thái:</span>
                            <!-- Tùy biến theo property IsPublished nếu có, mặc định giả định hiển thị hoạt động -->
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                <i class="bi bi-check-circle-fill me-1 small"></i> Hiển thị
                            </span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* CSS bổ sung giúp xử lý ảnh nội dung không bị vỡ layout bài viết */
        .post-content img {
            max-width: 100% !important;
            height: auto !important;
            border-radius: 0.375rem;
            margin: 1.5rem 0;
            box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
        }

        .leading-snug {
            line-height: 1.35;
        }

        .text-slate-900 {
            color: #0f172a;
        }

        .text-slate-800 {
            color: #1e293b;
        }

        .text-slate-700 {
            color: #334155;
        }
    </style>
}